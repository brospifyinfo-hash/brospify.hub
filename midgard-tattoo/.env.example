# ─── Midgard Tattoo — Konfiguration ────────────────────────────
# Kopiere diese Datei nach `.env.local` und trag die Werte ein.
# Auf Vercel gehören dieselben Schlüssel unter
# Project → Settings → Environment Variables.

# ══ PFLICHT ════════════════════════════════════════════════════

# Passwort für das Studio-Dashboard unter /admin.
# Ohne diese Variable ist der Admin-Bereich VOLLSTÄNDIG gesperrt —
# es gibt bewusst kein Standardpasswort und keinen offenen Zugang.
# Die öffentliche Seite und der Kalender laufen trotzdem.
#
# ⚠️ "1234" ist nur zum Ausprobieren gedacht. Vor dem Live-Gang durch ein
# echtes Passwort ersetzen: jeder, der die Adresse /admin kennt, hätte
# sonst Zugriff auf sämtliche Kundendaten.
TATTOO_ADMIN_PASSWORD=1234

# Schlüssel zum Verschlüsseln des Login-Cookies. Mindestens 32
# Zeichen, zufällig. Erzeugen z. B. mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TATTOO_SESSION_SECRET=

# ══ OPTIONAL ═══════════════════════════════════════════════════

# Öffentliche Adresse der Seite. Fließt in Canonical-Links,
# OpenGraph-Bilder, sitemap.xml und die Google-Structured-Data.
# Ohne Angabe wird https://midgard-tattoo.de angenommen.
NEXT_PUBLIC_SITE_URL=

# ── Terminspeicher ──
# Auf Vercel setzt der Blob-Store diese Variable automatisch, sobald
# ein Store mit dem Projekt verbunden ist. Ist sie gesetzt, landen die
# Termine dort; sonst in einer lokalen Datei (siehe TATTOO_DATA_FILE).
BLOB_READ_WRITE_TOKEN=

# Leitet den Dateinamen im Blob-Store ab (HMAC, damit die Datei nicht
# zu erraten ist). Ohne Angabe wird TATTOO_SESSION_SECRET verwendet.
# ⚠️ Nach dem ersten Speichern NICHT mehr ändern — sonst zeigt der
# Store auf eine neue, leere Datei und alle Termine sind „weg".
TATTOO_DATA_SECRET=

# Pfad des lokalen Datei-Stores (greift nur ohne Blob-Token).
# Standard: .data/tattoo-booking.json
TATTOO_DATA_FILE=

# ── E-Mail (Resend) ──
# Ohne diese Werte funktioniert die Buchung vollständig, es werden nur
# keine Mails verschickt — die Anfrage steht in jedem Fall im Dashboard.
# API-Key unter resend.com → API Keys, Domain dort vorher verifizieren.
RESEND_API_KEY=
# Absender. Muss auf einer bei Resend verifizierten Domain liegen.
RESEND_FROM_EMAIL=termin@midgard-tattoo.de
# Postfach des Studios: bekommt jede neue Terminanfrage zugeschickt.
# Fehlt der Wert, erhält nur der Kunde seine Eingangsbestätigung.
TATTOO_NOTIFY_EMAIL=

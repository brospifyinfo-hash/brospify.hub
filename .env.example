GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account_email@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----\n"

SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret

SESSION_SECRET=a_random_32_char_string_for_cookie_encryption

# Used by Vercel Cron jobs to authenticate against admin endpoints
# without a session cookie. Generate any 32+ char random string and
# set the same value in the Vercel project settings → Environment
# Variables. Without this, the hourly starter-credit backfill cron
# can't run (the admin UI button still works).
CRON_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Image upscaling ───────────────────────────────────────────────
# Clipdrop (existing single-mode upscaler at /ai-tools/upscaler)
CLIPDROP_API_KEY=

# Replicate (Hybrid Upscaler — High Quality / Cloud branch)
# Pay-per-second on a T4 GPU; ~1 ¢ per Real-ESRGAN 4× upscale.
# Get token: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Fal.ai (Magic Background Remover + AI Studio)
# Both tools share this key. Background remover uses
# `fal-ai/imageutils/rembg` (BRIA RMBG-1.4); AI Studio chains
# rembg → `fal-ai/iclight-v2` and then composites the original
# product pixels back over the relit output server-side so the
# product stays 1:1 (logos, texts) — only background and shadows
# come from the model. Get a key: https://fal.ai/dashboard/keys
FAL_KEY=

# ─── KI-Produktrecherche (Winning Charts) ──────────────────────
# Powers the admin "KI-Produkt finden" button: a fast pipeline that
# searches live US-dropshipping trends via Tavily, then has Claude
# synthesize a ready-to-review product (title, description, prices,
# real images, scores, AliExpress link).
#   ANTHROPIC_API_KEY — console.anthropic.com/settings/keys (needs billing credit)
#   TAVILY_API_KEY    — tavily.com (free tier is plenty)
# Without these keys the button returns an error; the manual
# "Produkt hinzufügen" flow is unaffected.
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# ─── Licence system ────────────────────────────────────────────
# Two SEPARATE keys, because the read path leaks and the write
# path must not.
#
# READ — used by the Shopify theme's license-check.liquid to call
# GET /api/license/validate. This key is embedded in the storefront
# HTML and is therefore semi-public; it only gates against random
# scraping. The endpoint fails OPEN if this is unset, so the user-
# facing storefront never goes dark from a deployment hiccup.
LICENSE_API_KEY=
# WRITE — used by Make.com to call POST /api/license/sync and
# /api/license/cancel. NEVER expose this key in any client-shipped
# code, theme file, or repo. The endpoint fails CLOSED when this
# is unset, so an unconfigured deployment refuses anonymous writes.
# Generate any 32+ char random string.
LICENSE_WRITE_KEY=

# ─── Shopify webhook → Hub (Make-free licence delivery) ────────────
# Shopify fires /api/shopify/webhook on orders/paid. The Hub
# verifies the HMAC signature with this shared secret — copy it
# from Shopify Admin → Settings → Notifications → Webhooks.
SHOPIFY_WEBHOOK_SECRET=
# Admin API access token from a Shopify Custom App with the
# write_order_metafields scope. Lets the Hub stamp the licence key
# onto the order so Shopify's own confirmation email renders it via
# {{ order.metafields.custom.license_key }} — no external mail
# service needed. If unset, the webhook falls back to Resend.
SHOPIFY_ADMIN_TOKEN=
# The *.myshopify.com handle of the shop (NOT the custom domain).
SHOPIFY_SHOP_DOMAIN=

# ─── Resend (fallback licence email) ───────────────────────────────
# Only used when SHOPIFY_ADMIN_TOKEN is NOT set. Sign up at
# resend.com, verify your sending domain, paste the API key here.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@brospify.com

# ─── Shopify webhook (direct order → Hub flow) ──────────────────
# Set when you create the webhook in Shopify Admin →
# Settings → Notifications → Webhooks. Shopify reveals the
# "Shared secret" once after webhook creation — paste it here.
# Used by /api/shopify/webhook for HMAC signature verification.
# Endpoint fails CLOSED on missing secret (rejects all requests).
SHOPIFY_WEBHOOK_SECRET=

# ─── Resend (transactional email) ──────────────────────────────
# Used by lib/email.ts to send licence-key emails after a Shopify
# webhook fires. Sign up at resend.com (free up to 3000/month),
# verify your domain, paste the API key here.
# Endpoint fails OPEN: license-issue still works without email,
# but the customer won't receive the key automatically.
RESEND_API_KEY=
# Must be on a verified Resend domain. e.g. noreply@brospify.com
RESEND_FROM_EMAIL=

